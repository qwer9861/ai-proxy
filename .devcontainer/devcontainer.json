{
  "name": "AI Proxy",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "postStartCommand": "cd /workspaces/ai-proxy && nohup node server.js > /tmp/proxy.log 2>&1 &",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "visibility": "public",
      "label": "AI Proxy",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"]
    }
  }
}
